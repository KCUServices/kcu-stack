# Ponte Tailscale: cada porta deste LXC encaminha para um serviço da rede de casa.
# Copia para nginx.conf e troca os endereços 192.0.2.x (exemplo) pelos teus.
#
# Regra simples:
#   - serviço normal            -> uma linha no bloco "stream" (encaminha TCP tal e qual)
#   - app que verifica o "Host" -> um server no bloco "http" (reescreve o cabeçalho)
# A mesma porta não pode estar nos dois blocos.

worker_processes 1;
events { worker_connections 1024; }

# --- Encaminhamento TCP simples (funciona com HTTP, HTTPS e WebSockets) ---
stream {
    proxy_connect_timeout 5s;
    proxy_timeout 1h;

    server { listen 8081; proxy_pass 192.0.2.10:8081; }   # exemplo: página inicial
    server { listen 8090; proxy_pass 192.0.2.20:8090; }   # exemplo: painel com HTTPS próprio
}

# --- Apps que só aceitam pedidos com o seu próprio nome (ex.: Vite) ---
# O Vite recusa pedidos cujo Host não conhece ("Blocked request. This host is not allowed").
# Em vez de mexer na app, a ponte reescreve o Host e o Origin para o endereço original.
http {
    map $http_upgrade $connection_upgrade { default upgrade; "" close; }

    server {
        listen 5173;
        client_max_body_size 200m;

        location / {
            proxy_pass http://192.0.2.30:5173;
            proxy_http_version 1.1;
            proxy_set_header Host 192.0.2.30:5173;
            proxy_set_header Origin http://192.0.2.30:5173;
            # WebSockets (o recarregamento automático do Vite usa-os)
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 1h;
        }
    }
}
